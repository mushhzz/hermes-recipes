worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
http {
    access_log off;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 20s;
    keepalive_timeout 10s;
    client_max_body_size 10m;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    proxy_connect_timeout 3s;
    proxy_send_timeout 20s;
    proxy_read_timeout 30s;
    proxy_request_buffering on;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    limit_req_zone $binary_remote_addr zone=kira_rate:1m rate=10r/s;
    limit_conn_zone $binary_remote_addr zone=kira_connections:1m;
    server {
        listen 127.0.0.1:{{ proxy_port }};
        location = /kira/webhooks/github {
            limit_except POST { deny all; }
            client_max_body_size 1m;
            limit_req zone=kira_rate burst=30 nodelay;
            limit_req_status 429;
            limit_conn kira_connections 32;
            proxy_pass http://127.0.0.1:{{ controller_port }}/webhooks/github;
        }
        location /kira/webhooks/incidents/ {
            limit_except POST { deny all; }
            client_max_body_size 1m;
            limit_req zone=kira_rate burst=30 nodelay;
            limit_req_status 429;
            limit_conn kira_connections 32;
            proxy_pass http://127.0.0.1:{{ controller_port }}/webhooks/incidents/;
        }
        location = /kira/health {
            limit_except GET { deny all; }
            limit_req zone=kira_rate burst=30 nodelay;
            limit_req_status 429;
            limit_conn kira_connections 32;
            proxy_pass http://127.0.0.1:{{ controller_port }}/health;
        }
        location / {
            proxy_pass http://127.0.0.1:{{ existing_gateway_port }};
        }
    }
}
