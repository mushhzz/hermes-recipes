# Exposes the Hermes gateway's webhook port through a stable ngrok domain, so
# GitHub/Grafana can reach it without opening a port on your router.
#
# Prerequisites:
#   - An ngrok account with a reserved (static) domain — the free tier
#     includes one. A domain that changes on every restart will silently
#     break every webhook pointed at it; see docs/lessons-learned.md-style
#     pain avoided by pinning one from the start.
#   - `ngrok config add-authtoken <token>` run once as the service's user.
#
# Install:
#   sudo cp ngrok-tunnel.service.example /etc/systemd/system/ngrok-tunnel.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ngrok-tunnel.service
#
# Replace <YOUR_USER>, <YOUR_GATEWAY_PORT> (matches Hermes' webhook
# platforms.webhook.extra.port, typically 8644), and <YOUR_STATIC_DOMAIN>
# below before installing.

[Unit]
Description=ngrok tunnel for the Hermes webhook gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<YOUR_USER>
ExecStart=/usr/local/bin/ngrok http <YOUR_GATEWAY_PORT> --url <YOUR_STATIC_DOMAIN> --log=stdout
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
